<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Light palette. Keys are shared with the other palette; ThemeManager swaps the whole dictionary. -->
    <Color x:Key="Window.Background.Color">#F2F4F7</Color>
    <SolidColorBrush x:Key="Window.Background" Color="{StaticResource Window.Background.Color}" />
