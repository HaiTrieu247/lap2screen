<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <!-- lets the WPF/WinForms targeting packs restore on macOS/Linux for compile checks -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <LangVersion>latest</LangVersion>
    <PlatformTarget>x64</PlatformTarget>
    <RootNamespace>MacExtend</RootNamespace>
    <AssemblyName>MacExtend</AssemblyName>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Version>1.0.0</Version>
    <Product>MacExtend</Product>
    <Description>AirPlay receiver for Mac extended displays and iPhone/iPad screen mirroring</Description>
    <Copyright>GPL-3.0-or-later</Copyright>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <PropertyGroup>
    <!-- GitHub repository the updater reads releases from; CI passes github.repository -->
    <UpdateRepository Condition="'$(UpdateRepository)' == ''">HaiTrieu247/lap2screen</UpdateRepository>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyMetadata Include="UpdateRepository" Value="$(UpdateRepository)" />
  </ItemGroup>

  <ItemGroup>
    <!-- the CoreDevice runtime zip this build was made with (CI passes -p:CoreDeviceRuntime*=...; empty in a local
         build). The keys are the ones RuntimePackage.FromMetadata reads. -->
    <AssemblyMetadata Include="CoreDeviceRuntimeId" Value="$(CoreDeviceRuntimeId)" />
    <AssemblyMetadata Include="CoreDeviceRuntimeFile" Value="$(CoreDeviceRuntimeFile)" />
    <AssemblyMetadata Include="CoreDeviceRuntimeSha256" Value="$(CoreDeviceRuntimeSha256)" />
    <AssemblyMetadata Include="CoreDeviceRuntimeSize" Value="$(CoreDeviceRuntimeSize)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MacExtend.Core\MacExtend.Core.csproj" />
    <ProjectReference Include="..\MacExtend.CoreDeviceHost\MacExtend.CoreDeviceHost.csproj" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.3179.45" />
    <Reference Include="System.Net.Http" />
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
    <!-- WinRT Bluetooth LE (GATT server) for .NET Framework; adds no files to the build output -->
    <PackageReference Include="Microsoft.Windows.SDK.Contracts" Version="10.0.26100.7705" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\Fonts\*.ttf" />
    <Resource Include="Assets\*.ico" />
    <Resource Include="Assets\app-256.png" />
    <None Include="Assets\Fonts\OFL-BeVietnamPro.txt" CopyToOutputDirectory="PreserveNewest" Link="licenses\OFL-BeVietnamPro.txt" />
    <!-- MacExtend.Core/Bluetooth adapts code from windows-ble-hid (MIT) -->
    <None Include="..\..\licenses\windows-ble-hid-LICENSE.txt" CopyToOutputDirectory="PreserveNewest" Link="licenses\windows-ble-hid-LICENSE.txt" />
  </ItemGroup>

</Project>
