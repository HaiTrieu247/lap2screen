<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <!-- lets the WPF/WinForms targeting packs restore on macOS/Linux for compile checks -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <LangVersion>latest</LangVersion>
    <PlatformTarget>x64</PlatformTarget>
    <RootNamespace>MacExtend</RootNamespace>
    <AssemblyName>MacExtend</AssemblyName>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Version>1.0.0</Version>
    <Product>MacExtend</Product>
    <Description>Turns this Windows laptop into a second display for a Mac</Description>
    <Copyright>GPL-3.0-or-later</Copyright>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\MacExtend.Core\MacExtend.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\Fonts\*.ttf" />
    <Resource Include="Assets\*.ico" />
    <Resource Include="Assets\app-256.png" />
    <None Include="Assets\Fonts\OFL-BeVietnamPro.txt" CopyToOutputDirectory="PreserveNewest" Link="licenses\OFL-BeVietnamPro.txt" />
  </ItemGroup>

</Project>
