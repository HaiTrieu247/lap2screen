<Window x:Class="MacExtend.Views.DirectPromptWindow"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Điều khiển trực tiếp"
        Width="440" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen" ShowInTaskbar="False"
        Background="{DynamicResource Window.Background}"
        Foreground="{DynamicResource Text.Primary}"
        FontFamily="{StaticResource Font.Sans}" FontSize="13.5"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True"
        Icon="pack://application:,,,/MacExtend;component/Assets/app.ico">

    <StackPanel Margin="24,20,24,20">
        <DockPanel>
            <TextBlock DockPanel.Dock="Left" Style="{StaticResource Text.Icon}" FontSize="20" Text="&#xE7BA;"
                       Foreground="{DynamicResource Notice.Text}" VerticalAlignment="Top" Margin="0,2,14,0" />
            <StackPanel>
                <TextBlock x:Name="Heading" Style="{StaticResource Text.Section}" TextWrapping="Wrap" />
                <TextBlock x:Name="Detail" Style="{StaticResource Text.Body}" Margin="0,6,0,0" />
            </StackPanel>
        </DockPanel>

        <!-- what the action is doing, then how it went -->
        <DockPanel x:Name="StatusLine" Margin="34,14,0,0" Visibility="Collapsed">
            <Grid x:Name="Spinner" DockPanel.Dock="Left" Width="14" Height="14" Margin="0,3,10,0" VerticalAlignment="Top" Visibility="Collapsed">
                <Ellipse Stroke="{DynamicResource Control.Pressed}" StrokeThickness="2" />
                <Path Data="M7,1 A6,6 0 0 1 13,7" Stroke="{DynamicResource Accent}" StrokeThickness="2"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" RenderTransformOrigin="0.5,0.5">
                    <!-- turned in code, and only while visible: a running animation keeps WPF rendering every frame -->
                    <Path.RenderTransform>
                        <RotateTransform x:Name="SpinnerTurn" />
                    </Path.RenderTransform>
                </Path>
            </Grid>
            <TextBlock x:Name="Status" Style="{StaticResource Text.Body}" />
        </DockPanel>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button x:Name="CloseButton" Content="Đóng" IsCancel="True" Style="{StaticResource Button.Secondary}" MinWidth="88" />
            <Button x:Name="ActionButton" Style="{StaticResource Button.Primary}" MinWidth="96" Margin="8,0,0,0"
                    Visibility="Collapsed" Click="OnAction" />
        </StackPanel>
    </StackPanel>
</Window>
