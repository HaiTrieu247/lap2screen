<Window x:Class="MacExtend.Views.CoreDeviceSetupWindow"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:core="clr-namespace:MacExtend.Core.CoreDevice;assembly=MacExtend.Core"
        Title="Thiết lập điều khiển trực tiếp"
        Width="600" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Window.Background}"
        Foreground="{DynamicResource Text.Primary}"
        FontFamily="{StaticResource Font.Sans}" FontSize="13.5"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True"
        Icon="pack://application:,,,/MacExtend;component/Assets/app.ico">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="Visible" />

        <!-- the step's number in a circle; a check once the step is done -->
        <Style x:Key="StepMarker" TargetType="Border">
            <Setter Property="Width" Value="24" />
            <Setter Property="Height" Value="24" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="Margin" Value="0,0,14,0" />
            <Setter Property="Background" Value="{DynamicResource Control.Pressed}" />
        </Style>
        <Style x:Key="StepChip" TargetType="Border">
            <Setter Property="CornerRadius" Value="9" />
            <Setter Property="Padding" Value="8,1,8,2" />
            <Setter Property="Margin" Value="8,0,0,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Background" Value="{DynamicResource Control.Pressed}" />
        </Style>
        <Style x:Key="StepChipText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource Text.Secondary}" />
        </Style>
        <Style x:Key="StepButton" TargetType="Button" BasedOn="{StaticResource Button.Secondary}">
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="MinWidth" Value="96" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="NextStepButton" TargetType="Button" BasedOn="{StaticResource Button.Primary}">
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="MinWidth" Value="96" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- header ========================================================================== -->
        <StackPanel Grid.Row="0" Margin="24,20,24,14">
            <TextBlock Text="Điều khiển trực tiếp" Style="{StaticResource Text.Headline}" FontSize="22" />
            <TextBlock Text="Xem và điều khiển iPhone, iPad qua cáp hoặc Wi-Fi, không cần AirPlay. Làm các bước dưới đây một lần."
                       Style="{StaticResource Text.Body}" Margin="0,4,0,0" />
            <Border CornerRadius="8" Padding="12,8" Margin="0,12,0,0" Background="{DynamicResource Success.Soft}"
                    Visibility="{Binding ShowReady, Converter={StaticResource Visible}}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Left" Style="{StaticResource Text.Icon}" Text="&#xE73E;" Foreground="{DynamicResource Success.SoftText}"
                               VerticalAlignment="Top" Margin="0,3,10,0" />
                    <TextBlock Text="{Binding ReadyText}" Style="{StaticResource Text.Body}" Foreground="{DynamicResource Success.SoftText}" />
                </DockPanel>
            </Border>
        </StackPanel>

        <!-- the steps; they scroll when the screen is short ===================================== -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Focusable="False">
            <StackPanel Margin="24,0,24,0">
                <Border Style="{StaticResource Sheet}">
                    <StackPanel Margin="0,4">
                        <ItemsControl ItemsSource="{Binding Steps}" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <Border Style="{StaticResource Hairline}" Visibility="{Binding ShowDivider, Converter={StaticResource Visible}}" />
                                        <Grid Style="{StaticResource Row}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Border x:Name="Marker" Style="{StaticResource StepMarker}">
                                                <Grid>
                                                    <TextBlock x:Name="MarkerNumber" Text="{Binding Number}" FontSize="12" FontWeight="SemiBold"
                                                               Foreground="{DynamicResource Text.Tertiary}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    <TextBlock x:Name="MarkerCheck" Style="{StaticResource Text.Icon}" Text="&#xE73E;" FontSize="12"
                                                               Foreground="{DynamicResource Success.SoftText}" HorizontalAlignment="Center" Visibility="Collapsed" />
                                                </Grid>
                                            </Border>
                                            <StackPanel Grid.Column="1" Margin="0,2,16,0" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Title}" Style="{StaticResource Text.Label}" VerticalAlignment="Center" />
                                                    <Border x:Name="Chip" Style="{StaticResource StepChip}"
                                                            Visibility="{Binding ShowChip, Converter={StaticResource Visible}}">
                                                        <TextBlock x:Name="ChipText" Text="{Binding StatusText}" Style="{StaticResource StepChipText}" />
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock Text="{Binding Detail}" Style="{StaticResource Text.Caption}" Margin="0,3,0,0" />
                                            </StackPanel>
                                            <!-- the first step still to do gets the primary button -->
                                            <Button Grid.Column="2" Content="{Binding ActionText}" Command="{Binding Action}" Style="{StaticResource NextStepButton}"
                                                    Visibility="{Binding ShowPrimaryAction, Converter={StaticResource Visible}}" />
                                            <Button Grid.Column="2" Content="{Binding ActionText}" Command="{Binding Action}" Style="{StaticResource StepButton}"
                                                    Visibility="{Binding ShowSecondaryAction, Converter={StaticResource Visible}}" />
                                        </Grid>
                                    </StackPanel>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding Chip}" Value="Done">
                                            <Setter TargetName="Marker" Property="Background" Value="{DynamicResource Success.Soft}" />
                                            <Setter TargetName="MarkerNumber" Property="Visibility" Value="Collapsed" />
                                            <Setter TargetName="MarkerCheck" Property="Visibility" Value="Visible" />
                                            <Setter TargetName="Chip" Property="Background" Value="{DynamicResource Success.Soft}" />
                                            <Setter TargetName="ChipText" Property="Foreground" Value="{DynamicResource Success.SoftText}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Chip}" Value="Todo">
                                            <Setter TargetName="Marker" Property="Background" Value="{DynamicResource Accent.Soft}" />
                                            <Setter TargetName="MarkerNumber" Property="Foreground" Value="{DynamicResource Accent.SoftText}" />
                                            <Setter TargetName="Chip" Property="Background" Value="{DynamicResource Accent.Soft}" />
                                            <Setter TargetName="ChipText" Property="Foreground" Value="{DynamicResource Accent.SoftText}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Chip}" Value="Running">
                                            <Setter TargetName="Marker" Property="Background" Value="{DynamicResource Accent}" />
                                            <Setter TargetName="MarkerNumber" Property="Foreground" Value="{DynamicResource Accent.Text}" />
                                            <Setter TargetName="Chip" Property="Background" Value="{DynamicResource Accent}" />
                                            <Setter TargetName="ChipText" Property="Foreground" Value="{DynamicResource Accent.Text}" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- per device: the one on the cable (pairing needs it) -->
                        <Border Style="{StaticResource Hairline}" />
                        <Grid Style="{StaticResource Row}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="38" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="1" Margin="0,0,16,0" VerticalAlignment="Center">
                                <TextBlock Text="Cho phép điều khiển qua Wi-Fi" Style="{StaticResource Text.Label}" />
                                <TextBlock Text="{Binding WifiHint}" Style="{StaticResource Text.Caption}" Margin="0,2,0,0" />
                            </StackPanel>
                            <CheckBox Grid.Column="2" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding WifiWanted}"
                                      IsEnabled="{Binding WifiSwitchEnabled}" AutomationProperties.Name="Cho phép điều khiển qua Wi-Fi" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- the two limits of every session -->
                <Border Style="{StaticResource Sheet}" Margin="0,12,0,0" Padding="20,14">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Left" Style="{StaticResource Text.Icon}" Text="&#xE946;" Foreground="{DynamicResource Text.Secondary}"
                                   VerticalAlignment="Top" Margin="0,2,14,0" />
                        <StackPanel>
                            <TextBlock Text="Trong lúc điều khiển" Style="{StaticResource Text.Label}" />
                            <TextBlock Text="Camera và micro của thiết bị không dùng được." Style="{StaticResource Text.Caption}" Margin="0,4,0,0" />
                            <TextBlock Text="Màn hình thiết bị phải đang bật thì mới có hình. Nếu màn hình tắt, mở khóa thiết bị."
                                       Style="{StaticResource Text.Caption}" Margin="0,2,0,0" />
                        </StackPanel>
                    </DockPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- what is happening now ================================================================ -->
        <StackPanel Grid.Row="2" Margin="24,14,24,0">
            <ProgressBar Style="{StaticResource ThinProgress}" Maximum="1" Value="{Binding Progress, Mode=OneWay}" Margin="0,0,0,8"
                         Visibility="{Binding ShowProgress, Converter={StaticResource Visible}}" />
            <DockPanel Visibility="{Binding HasMessage, Converter={StaticResource Visible}}">
                <Grid x:Name="Spinner" DockPanel.Dock="Left" Width="14" Height="14" Margin="0,3,10,0" VerticalAlignment="Top"
                      Visibility="{Binding ShowSpinner, Converter={StaticResource Visible}}">
                    <Ellipse Stroke="{DynamicResource Control.Pressed}" StrokeThickness="2" />
                    <Path Data="M7,1 A6,6 0 0 1 13,7" Stroke="{DynamicResource Accent}" StrokeThickness="2"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" RenderTransformOrigin="0.5,0.5">
                        <!-- turned in code, and only while visible: a running animation keeps WPF rendering every frame -->
                        <Path.RenderTransform>
                            <RotateTransform x:Name="SpinnerTurn" />
                        </Path.RenderTransform>
                    </Path>
                </Grid>
                <TextBlock Text="{Binding Message}" Style="{StaticResource Text.Body}" />
            </DockPanel>
        </StackPanel>

        <!-- footer ================================================================================ -->
        <Grid Grid.Row="3" Margin="24,16,24,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button Content="{x:Static core:SetupActions.PickZip}" Command="{Binding PickZipCommand}" Style="{StaticResource Button.Subtle}"
                    Margin="-10,0,0,0" ToolTip="Gói runtime tải từ artifact CI, cho bản beta chưa có bản phát hành" />
            <Button Grid.Column="2" Content="{x:Static core:SetupActions.Refresh}" Command="{Binding RefreshCommand}"
                    Style="{StaticResource Button.Secondary}" Margin="0,0,8,0" />
            <Button Grid.Column="3" Content="Đóng" IsCancel="True" Style="{StaticResource Button.Secondary}" MinWidth="88" Click="OnClose" />
        </Grid>
    </Grid>
</Window>
