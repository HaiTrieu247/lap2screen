<UserControl x:Class="MacExtend.Views.DisplayStage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Height="188">
    <!--
      The hero shows the AirPlay path: the sending device on the left, an arrow, and this laptop
      on the right. The sender is a plain screen with no menu bar or notch, because it can be a
      Mac, an iPhone or an iPad. This laptop is an empty dashed outline while waiting and fills
      in once a device is connected.
    -->
    <Border CornerRadius="12" Background="{DynamicResource Stage.Background}" ClipToBounds="True">
        <Grid>
            <!-- dot grid of the canvas -->
            <Rectangle>
                <Rectangle.Fill>
                    <DrawingBrush TileMode="Tile" Viewport="0,0,16,16" ViewportUnits="Absolute" Stretch="None">
                        <DrawingBrush.Drawing>
                            <DrawingGroup>
                                <!-- transparent square sets the tile size; the dot sits in its centre -->
                                <GeometryDrawing Brush="Transparent">
                                    <GeometryDrawing.Geometry>
                                        <RectangleGeometry Rect="0,0,16,16" />
                                    </GeometryDrawing.Geometry>
                                </GeometryDrawing>
                                <GeometryDrawing Brush="{DynamicResource Stage.Grid}">
                                    <GeometryDrawing.Geometry>
                                        <EllipseGeometry Center="8,8" RadiusX="1.1" RadiusY="1.1" />
                                    </GeometryDrawing.Geometry>
                                </GeometryDrawing>
                            </DrawingGroup>
                        </DrawingBrush.Drawing>
                    </DrawingBrush>
                </Rectangle.Fill>
            </Rectangle>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-6,0,0">
                <!-- sending device: 16:10, the same shape whatever is connected -->
                <Grid x:Name="SourceDisplay" Width="144" Height="90" VerticalAlignment="Center">
                    <Border CornerRadius="8" BorderThickness="2" Background="{DynamicResource Display.Idle}"
                            BorderBrush="{DynamicResource Display.Mac}" />
                    <TextBlock x:Name="SourceLabel" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Stage.Text}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" Margin="12,0"
                               TextWrapping="Wrap" LineHeight="16" LineStackingStrategy="BlockLineHeight" MaxHeight="32"
                               TextTrimming="CharacterEllipsis" />
                </Grid>

                <!-- AirPlay carries the picture from the device to this laptop -->
                <Path x:Name="Arrow" Width="24" Height="12" Margin="12,0" VerticalAlignment="Center"
                      Data="M1,6 H22 M17,1.5 L22,6 L17,10.5" Stroke="{DynamicResource Stage.TextDim}" StrokeThickness="1.75"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />

                <!-- This laptop: 16:9 -->
                <Grid x:Name="SecondDisplay" Width="168" Height="94.5" VerticalAlignment="Center">
                    <Rectangle x:Name="SecondFill" RadiusX="6" RadiusY="6" Opacity="0">
                        <Rectangle.Fill>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="{DynamicResource Status.Ready.Color}" Offset="0" />
                                <GradientStop Color="{DynamicResource Accent.Pressed.Color}" Offset="1" />
                            </LinearGradientBrush>
                        </Rectangle.Fill>
                    </Rectangle>
                    <Rectangle x:Name="SecondOutline" RadiusX="6" RadiusY="6" StrokeThickness="1.5"
                               StrokeDashArray="4 3" Stroke="{DynamicResource Stage.TextDim}" />
                    <StackPanel VerticalAlignment="Center" Margin="10,0">
                        <TextBlock x:Name="DeviceLabel" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Stage.Text}"
                                   HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"
                                   MaxHeight="34" TextTrimming="CharacterEllipsis" />
                        <!-- the size MacExtend asks for; the sender may still choose another one -->
                        <TextBlock x:Name="ModeLabel" FontSize="11.5" Foreground="{DynamicResource Stage.TextDim}"
                                   HorizontalAlignment="Center" TextAlignment="Center" Margin="0,3,0,0" TextWrapping="Wrap"
                                   LineHeight="15" LineStackingStrategy="BlockLineHeight" MaxHeight="30"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Grid>
            </StackPanel>

            <!-- what the picture means, in words, for people who do not read diagrams -->
            <TextBlock x:Name="Caption" FontSize="12" Foreground="{DynamicResource Stage.TextDim}"
                       HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="16,0,16,14"
                       TextTrimming="CharacterEllipsis" />
        </Grid>
    </Border>
</UserControl>
