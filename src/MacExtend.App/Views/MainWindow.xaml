<Window x:Class="MacExtend.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:MacExtend.Views"
        Title="MacExtend"
        Width="1020" Height="700" MinWidth="1020"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" ResizeMode="CanMinimize"
        Background="{DynamicResource Window.Background}"
        Foreground="{DynamicResource Text.Primary}"
        FontFamily="{StaticResource Font.Sans}" FontSize="13.5"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True"
        Icon="pack://application:,,,/MacExtend;component/Assets/app.ico">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40" ResizeBorderThickness="0" GlassFrameThickness="0,0,0,1"
                      CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="Visible" />

        <!-- status dot beside the headline -->
        <Style x:Key="PhaseDot" TargetType="Ellipse">
            <Setter Property="Width" Value="10" />
            <Setter Property="Height" Value="10" />
            <Setter Property="Fill" Value="{DynamicResource Status.Stopped}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Phase}" Value="Starting">
                    <Setter Property="Fill" Value="{DynamicResource Status.Ready}" />
                    <Setter Property="Opacity" Value="0.5" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Phase}" Value="Ready">
                    <Setter Property="Fill" Value="{DynamicResource Status.Ready}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Phase}" Value="Connected">
                    <Setter Property="Fill" Value="{DynamicResource Status.Connected}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Phase}" Value="Failed">
                    <Setter Property="Fill" Value="{DynamicResource Status.Error}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- numbered step marker; the steps really are a sequence on the Mac -->
        <Style x:Key="StepNumber" TargetType="Border">
            <Setter Property="Width" Value="24" />
            <Setter Property="Height" Value="24" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Background" Value="{DynamicResource Accent.Soft}" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="Margin" Value="0,0,12,0" />
        </Style>
        <Style x:Key="StepNumberText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource Accent.SoftText}" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- check rows (firewall, network): glyph and colour follow the state -->
        <Style x:Key="CheckGlyph" TargetType="TextBlock" BasedOn="{StaticResource Text.Icon}">
            <Setter Property="Text" Value="&#xE9F5;" />
            <Setter Property="Foreground" Value="{DynamicResource Text.Tertiary}" />
            <Setter Property="Margin" Value="0,2,10,0" />
            <Setter Property="VerticalAlignment" Value="Top" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- title bar ======================================================================== -->
        <Grid Grid.Row="0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                <Image Source="pack://application:,,,/MacExtend;component/Assets/app-256.png" Width="18" Height="18"
                       RenderOptions.BitmapScalingMode="HighQuality" />
                <TextBlock Text="MacExtend" FontSize="12.5" FontWeight="SemiBold" Margin="10,0,0,0" VerticalAlignment="Center" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Style="{StaticResource Button.Caption}" Content="&#xE921;" Click="OnMinimize"
                        WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="Thu nhỏ" />
                <Button Style="{StaticResource Button.CaptionClose}" Content="&#xE8BB;" Click="OnClose"
                        WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="Ẩn xuống khay hệ thống" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="456" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- left: what is happening and how to connect =================================== -->
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Focusable="False">
                <StackPanel Margin="28,8,24,28">
                    <views:DisplayStage Phase="{Binding Phase}" ClientName="{Binding ClientName}"
                                        DeviceName="{Binding EffectiveDeviceName}" ModeText="{Binding ModeText}" />

                    <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
                        <Ellipse Style="{StaticResource PhaseDot}" VerticalAlignment="Center" Margin="2,4,12,0" />
                        <TextBlock Text="{Binding StatusTitle}" Style="{StaticResource Text.Headline}" />
                    </StackPanel>
                    <TextBlock Text="{Binding StatusDetail}" Style="{StaticResource Text.Body}" Margin="24,6,0,0" />

                    <StackPanel Orientation="Horizontal" Margin="24,20,0,0">
                        <Button Content="Bắt đầu" Style="{StaticResource Button.Primary}" Command="{Binding StartCommand}"
                                Visibility="{Binding CanStart, Converter={StaticResource Visible}}" MinWidth="112" />
                        <Button Content="Dừng" Style="{StaticResource Button.Secondary}" Command="{Binding StopCommand}"
                                Visibility="{Binding IsActive, Converter={StaticResource Visible}}" MinWidth="96" />
                        <Button Content="Khởi động lại" Style="{StaticResource Button.Subtle}" Command="{Binding RestartCommand}"
                                Visibility="{Binding IsActive, Converter={StaticResource Visible}}" Margin="8,0,0,0" />
                    </StackPanel>

                    <TextBlock Text="Kết nối từ Mac" Style="{StaticResource Text.Section}" Margin="24,26,0,14" />
                    <StackPanel Margin="24,0,0,0">
                        <DockPanel Margin="0,0,0,12">
                            <Border Style="{StaticResource StepNumber}"><TextBlock Text="1" Style="{StaticResource StepNumberText}" /></Border>
                            <StackPanel>
                                <TextBlock Text="Mở Trung tâm điều khiển trên Mac" Style="{StaticResource Text.Label}" />
                                <TextBlock Text="Control Center, ở góc phải thanh menu" Style="{StaticResource Text.Caption}" />
                            </StackPanel>
                        </DockPanel>
                        <DockPanel Margin="0,0,0,12">
                            <Border Style="{StaticResource StepNumber}"><TextBlock Text="2" Style="{StaticResource StepNumberText}" /></Border>
                            <StackPanel>
                                <TextBlock Text="Bấm Phản chiếu màn hình" Style="{StaticResource Text.Label}" />
                                <TextBlock Text="Screen Mirroring" Style="{StaticResource Text.Caption}" />
                            </StackPanel>
                        </DockPanel>
                        <DockPanel Margin="0,0,0,12">
                            <Border Style="{StaticResource StepNumber}"><TextBlock Text="3" Style="{StaticResource StepNumberText}" /></Border>
                            <StackPanel>
                                <TextBlock Text="{Binding StepChooseDevice}" Style="{StaticResource Text.Label}" />
                                <!-- the PIN lives in the step where the Mac asks for it -->
                                <TextBlock Style="{StaticResource Text.Caption}" Visibility="{Binding ShowPin, Converter={StaticResource Visible}}">
                                    <Run Text="Nhập mã" />
                                    <Run Text="{Binding PinDisplay, Mode=OneWay}" FontSize="15" FontWeight="SemiBold"
                                         Foreground="{DynamicResource Text.Primary}" />
                                    <Run Text="nếu Mac hỏi. Chỉ cần nhập ở lần đầu." />
                                </TextBlock>
                                <TextBlock Text="Không cần mã PIN." Style="{StaticResource Text.Caption}"
                                           Visibility="{Binding PinOff, Converter={StaticResource Visible}}" />
                            </StackPanel>
                        </DockPanel>
                        <DockPanel>
                            <Border Style="{StaticResource StepNumber}"><TextBlock Text="4" Style="{StaticResource StepNumberText}" /></Border>
                            <StackPanel>
                                <TextBlock Text="Chọn Dùng làm màn hình riêng" Style="{StaticResource Text.Label}" />
                                <TextBlock Text="Use As Separate Display. Có thể bấm lại biểu tượng Phản chiếu màn hình để đổi." Style="{StaticResource Text.Caption}" />
                            </StackPanel>
                        </DockPanel>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <!-- right: settings ============================================================== -->
            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Focusable="False">
                <StackPanel Margin="4,8,28,28">

                    <!-- a newer release is on GitHub -->
                    <Border CornerRadius="10" Padding="16,12" Margin="0,0,0,16" BorderThickness="1"
                            Background="{DynamicResource Accent.Soft}" BorderBrush="{DynamicResource Accent}"
                            Visibility="{Binding Update.ShowBanner, Converter={StaticResource Visible}}">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="Cập nhật" Style="{StaticResource Button.Primary}"
                                    Command="{Binding Update.InstallCommand}" Padding="14,6" Margin="12,0,0,0" VerticalAlignment="Center"
                                    Visibility="{Binding Update.ShowInstallButton, Converter={StaticResource Visible}}" />
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding Update.BannerTitle}" Style="{StaticResource Text.Label}"
                                           Foreground="{DynamicResource Accent.SoftText}" />
                                <TextBlock Text="{Binding Update.BannerDetail}" Style="{StaticResource Text.Caption}" Margin="0,2,0,0" />
                                <ProgressBar Style="{StaticResource ThinProgress}" Maximum="100" Margin="0,8,0,0"
                                             Value="{Binding Update.Progress, Mode=OneWay}"
                                             Visibility="{Binding Update.ShowProgress, Converter={StaticResource Visible}}" />
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <Border CornerRadius="10" Padding="16,12" Margin="0,0,0,16" BorderThickness="1"
                            Background="{DynamicResource Notice.Background}" BorderBrush="{DynamicResource Notice.Border}"
                            Visibility="{Binding NeedsRestart, Converter={StaticResource Visible}}">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="Khởi động lại" Style="{StaticResource Button.Secondary}"
                                    Command="{Binding RestartCommand}" Padding="12,6" Margin="12,0,0,0" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding RestartNotice}" Style="{StaticResource Text.Body}"
                                       Foreground="{DynamicResource Notice.Text}" VerticalAlignment="Center" />
                        </DockPanel>
                    </Border>

                    <Border Style="{StaticResource Sheet}">
                        <StackPanel Margin="0,0,0,8">

                            <!-- device -->
                            <TextBlock Text="Thiết bị" Style="{StaticResource SectionHeader}" />
                            <Grid Style="{StaticResource Row}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,16,0" VerticalAlignment="Center">
                                    <TextBlock Text="Tên hiện trên Mac" Style="{StaticResource Text.Label}" />
                                    <TextBlock Style="{StaticResource Text.Caption}" Margin="0,2,0,0">
                                        <Run Text="Mac sẽ thấy:" />
                                        <Run Text="{Binding EffectiveDeviceName, Mode=OneWay}" FontWeight="Medium" />
                                    </TextBlock>
                                </StackPanel>
                                <Grid Grid.Column="1" Width="230" VerticalAlignment="Center">
                                    <TextBox x:Name="NameBox" Text="{Binding DeviceNameInput, UpdateSourceTrigger=PropertyChanged}" MaxLength="60" />
                                    <TextBlock Text="{Binding DeviceNamePlaceholder}" IsHitTestVisible="False" Margin="10,0"
                                               VerticalAlignment="Center" Foreground="{DynamicResource Text.Tertiary}"
                                               TextTrimming="CharacterEllipsis">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Text, ElementName=NameBox}" Value="">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                            </Grid>

                            <Border Style="{StaticResource Hairline}" Margin="0,6,0,0" />

                            <!-- picture -->
                            <TextBlock Text="Hình ảnh" Style="{StaticResource SectionHeader}" />
                            <Grid Style="{StaticResource Row}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,16,0" VerticalAlignment="Center">
                                    <TextBlock Text="Độ phân giải" Style="{StaticResource Text.Label}" />
                                    <TextBlock Text="{Binding AutoResolutionDetail}" Style="{StaticResource Text.Caption}" Margin="0,2,0,0" />
                                </StackPanel>
                                <Border Grid.Column="1" Style="{StaticResource SegmentGroup}">
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton Content="Tự động" Style="{StaticResource Segment}" GroupName="Resolution"
                                                     IsChecked="{Binding IsAutoResolution}" />
                                        <RadioButton Content="Tùy chỉnh" Style="{StaticResource Segment}" GroupName="Resolution"
                                                     IsChecked="{Binding IsCustomResolution}" />
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <StackPanel Visibility="{Binding IsCustomResolution, Converter={StaticResource Visible}}">
                                <Border Style="{StaticResource Hairline}" />
                                <Grid Style="{StaticResource Row}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,16,0" VerticalAlignment="Center">
                                        <TextBlock Text="Kích thước gửi cho Mac" Style="{StaticResource Text.Label}" />
                                        <TextBlock Text="Rộng × cao, tần số quét. Màn hình này tự co giãn cho vừa." Style="{StaticResource Text.Caption}" Margin="0,2,0,0" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBox Text="{Binding CustomWidthText}" Width="68" TextAlignment="Center" MaxLength="4" ToolTip="Rộng (640 đến 4096)" />
                                        <TextBlock Text="×" Margin="8,0" VerticalAlignment="Center" Foreground="{DynamicResource Text.Secondary}" />
                                        <TextBox Text="{Binding CustomHeightText}" Width="68" TextAlignment="Center" MaxLength="4" ToolTip="Cao (480 đến 2304)" />
                                        <TextBox Text="{Binding CustomRefreshText}" Width="56" TextAlignment="Center" MaxLength="3" Margin="12,0,0,0" ToolTip="Tần số quét (24 đến 240)" />
                                        <TextBlock Text="Hz" Margin="8,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource Text.Secondary}" />
                                    </StackPanel>
                                </Grid>
                                <Border Style="{StaticResource Hairline}" />
                                <Grid Style="{StaticResource Row}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,16,0" VerticalAlignment="Center">
                                        <TextBlock Text="Dùng H.265" Style="{StaticResource Text.Label}" />
                                        <TextBlock Text="Cần cho kích thước trên 1080p. Card đồ họa phải giải mã được HEVC." Style="{StaticResource Text.Caption}" Margin="0,2,0,0" />
                                    </StackPanel>
                                    <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding CustomH265}" />
                                </Grid>
                            </StackPanel>

                            <Border Style="{StaticResource Hairline}" />
                            <Grid Style="{StaticResource Row}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,16,0" VerticalAlignment="Center">
                                    <TextBlock Text="Khung hình mỗi giây" Style="{StaticResource Text.Label}" />
                                    <TextBlock Text="60 mượt hơn khi kéo cửa sổ, 30 nhẹ cho Wi-Fi yếu." Style="{StaticResource Text.Caption}" Margin="0,2,0,0" />
                                </StackPanel>
                                <Border Grid.Column="1" Style="{StaticResource SegmentGroup}">
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton Content="30" Style="{StaticResource Segment}" GroupName="Fps" IsChecked="{Binding IsFps30}" />
                                        <RadioButton Content="60" Style="{StaticResource Segment}" GroupName="Fps" IsChecked="{Binding IsFps60}" />
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <Border Style="{StaticResource Hairline}" Margin="0,6,0,0" />

                            <!-- sound -->
                            <TextBlock Text="Âm thanh" Style="{StaticResource SectionHeader}" />
                            <Grid Style="{StaticResource Row}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,16,0" VerticalAlignment="Center">
                                    <TextBlock Text="Phát âm thanh của Mac trên máy này" Style="{StaticResource Text.Label}" />
                                    <TextBlock Text="Tắt nếu bạn muốn nghe bằng loa hoặc tai nghe của Mac." Style="{StaticResource Text.Caption}" Margin="0,2,0,0" />
                                </StackPanel>
                                <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding AudioEnabled}" />
                            </Grid>

                            <Border Style="{StaticResource Hairline}" Margin="0,6,0,0" />

                            <!-- security -->
                            <TextBlock Text="Bảo mật" Style="{StaticResource SectionHeader}" />
                            <Grid Style="{StaticResource Row}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,16,0" VerticalAlignment="Center">
                                    <TextBlock Text="Yêu cầu mã PIN" Style="{StaticResource Text.Label}" />
                                    <TextBlock Text="Người khác trong cùng mạng không thể chiếu lên máy này khi chưa có mã." Style="{StaticResource Text.Caption}" Margin="0,2,0,0" />
                                </StackPanel>
                                <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding PinEnabled}" />
                            </Grid>
                            <Border Style="{StaticResource Hairline}" />
                            <Grid Style="{StaticResource Row}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,16,0" VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource Text.Label}">
                                        <Run Text="Mã hiện tại:" />
                                        <Run Text="{Binding Pin, Mode=OneWay}" FontWeight="SemiBold" />
                                    </TextBlock>
                                    <TextBlock Text="Mã mới có hiệu lực sau khi khởi động lại bộ nhận." Style="{StaticResource Text.Caption}" Margin="0,2,0,0" />
                                </StackPanel>
                                <Button Grid.Column="1" Content="Tạo mã mới" Style="{StaticResource Button.Secondary}"
                                        Command="{Binding NewPinCommand}" Padding="12,6" VerticalAlignment="Center" />
                            </Grid>
                            <Border Style="{StaticResource Hairline}" />
                            <Grid Style="{StaticResource Row}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,16,0" VerticalAlignment="Center">
                                    <TextBlock Text="Các Mac đã ghép nối" Style="{StaticResource Text.Label}" />
                                    <TextBlock Text="Bắt mọi Mac nhập lại mã PIN ở lần kết nối tới." Style="{StaticResource Text.Caption}" Margin="0,2,0,0" />
                                </StackPanel>
                                <Button Grid.Column="1" Content="Quên tất cả" Style="{StaticResource Button.Secondary}"
                                        Command="{Binding ForgetMacsCommand}" Padding="12,6" VerticalAlignment="Center" />
                            </Grid>

                            <Border Style="{StaticResource Hairline}" Margin="0,6,0,0" />

                            <!-- system -->
                            <TextBlock Text="Hệ thống" Style="{StaticResource SectionHeader}" />
                            <Grid Style="{StaticResource Row}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,16,0" VerticalAlignment="Center">
                                    <TextBlock Text="Khởi động cùng Windows" Style="{StaticResource Text.Label}" />
                                    <TextBlock Text="Chạy ẩn ở khay hệ thống sau khi đăng nhập, Mac thấy máy này ngay." Style="{StaticResource Text.Caption}" Margin="0,2,0,0" />
                                </StackPanel>
                                <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding StartWithWindows}" />
                            </Grid>
                            <Border Style="{StaticResource Hairline}" />
                            <Grid Style="{StaticResource Row}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,16,0" VerticalAlignment="Center">
                                    <TextBlock Text="Tự kiểm tra cập nhật" Style="{StaticResource Text.Label}" />
                                    <TextBlock Text="Xem GitHub có bản mới khi mở app và mỗi 6 giờ. Chỉ cài khi bạn bấm Cập nhật." Style="{StaticResource Text.Caption}" Margin="0,2,0,0" />
                                </StackPanel>
                                <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding AutoCheckUpdates}" />
                            </Grid>
                            <Border Style="{StaticResource Hairline}" />
                            <Grid Style="{StaticResource Row}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock>
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource CheckGlyph}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding FirewallState}" Value="Ok">
                                                    <Setter Property="Text" Value="&#xE73E;" />
                                                    <Setter Property="Foreground" Value="{DynamicResource Status.Connected}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding FirewallState}" Value="Problem">
                                                    <Setter Property="Text" Value="&#xE7BA;" />
                                                    <Setter Property="Foreground" Value="{DynamicResource Status.Error}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <StackPanel Grid.Column="1" Margin="0,0,16,0" VerticalAlignment="Center">
                                    <TextBlock Text="Tường lửa Windows" Style="{StaticResource Text.Label}" />
                                    <TextBlock Text="{Binding FirewallText}" Style="{StaticResource Text.Caption}" Margin="0,2,0,0" />
                                </StackPanel>
                                <Button Grid.Column="2" Content="Cho phép" Style="{StaticResource Button.Secondary}"
                                        Command="{Binding FixFirewallCommand}" Padding="12,6" VerticalAlignment="Center" />
                            </Grid>
                            <Border Style="{StaticResource Hairline}" />
                            <Grid Style="{StaticResource Row}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock>
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource CheckGlyph}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding NetworkState}" Value="Ok">
                                                    <Setter Property="Text" Value="&#xE73E;" />
                                                    <Setter Property="Foreground" Value="{DynamicResource Status.Connected}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding NetworkState}" Value="Problem">
                                                    <Setter Property="Text" Value="&#xE7BA;" />
                                                    <Setter Property="Foreground" Value="{DynamicResource Status.Error}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <StackPanel Grid.Column="1" Margin="0,0,16,0" VerticalAlignment="Center">
                                    <TextBlock Text="Mạng" Style="{StaticResource Text.Label}" />
                                    <TextBlock Text="{Binding NetworkText}" Style="{StaticResource Text.Caption}" Margin="0,2,0,0" />
                                </StackPanel>
                                <Button Grid.Column="2" Content="Chuyển sang Riêng tư" Style="{StaticResource Button.Secondary}"
                                        Command="{Binding MakePrivateCommand}" Padding="12,6" VerticalAlignment="Center"
                                        Visibility="{Binding CanMakePrivate, Converter={StaticResource Visible}}" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="{Binding SystemMessage}" Margin="4,14,4,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Body}">
                                <Style.Triggers>
                                    <Trigger Property="Text" Value="">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </Trigger>
                                    <Trigger Property="Text" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <DockPanel Margin="4,18,0,0">
                        <Button DockPanel.Dock="Right" Content="Mở thư mục nhật ký" Style="{StaticResource Button.Subtle}"
                                Command="{Binding OpenLogsCommand}" VerticalAlignment="Center" />
                        <Button DockPanel.Dock="Right" Content="Kiểm tra cập nhật" Style="{StaticResource Button.Subtle}"
                                Command="{Binding Update.CheckCommand}" VerticalAlignment="Center" />
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding VersionText}" Style="{StaticResource Text.Caption}"
                                       Foreground="{DynamicResource Text.Tertiary}" />
                            <TextBlock Text="{Binding Update.StatusText}" Margin="0,2,0,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Caption}">
                                        <Style.Triggers>
                                            <Trigger Property="Text" Value="">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </DockPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
